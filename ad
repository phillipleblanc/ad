)


class AdError(Exception):
    """User-facing error."""


def die(msg: str, code: int = 1) -> None:
    print(f"ad: {msg}", file=sys.stderr)
    raise SystemExit(code)


def require_herdr() -> None:
    if os.environ.get("HERDR_ENV") != "1":
        die("not running under herdr (HERDR_ENV is not set)")


def herdr_run(args: Sequence[str]) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            ["herdr", *args],
            check=False,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        die("herdr binary not found on PATH")
        raise  # unreachable; keeps type-checkers happy


def herdr_json(args: Sequence[str]) -> Any:
    proc = herdr_run(args)
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip() or f"exit {proc.returncode}"
        die(f"herdr {' '.join(args)} failed: {err}")

    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        die(f"herdr {' '.join(args)} returned invalid JSON: {exc}")


def tab_info(tab_id: str) -> Dict[str, Any]:
    payload = herdr_json(["tab", "get", tab_id])
    tab = payload.get("result", {}).get("tab")
    if not isinstance(tab, dict):
        die(f"unexpected response from herdr tab get {tab_id}")
    return tab


def list_tabs(workspace_id: Optional[str] = None) -> List[Dict[str, Any]]:
    args: List[str] = ["tab", "list"]
    if workspace_id:
        args.extend(["--workspace", workspace_id])
    payload = herdr_json(args)
    tabs = payload.get("result", {}).get("tabs")
    if not isinstance(tabs, list):
        die("unexpected response from herdr tab list")
    return tabs


def soft_current_identity() -> Optional[Tuple[str, str, str]]:
    """Best-effort identity; returns None when not under herdr / unavailable."""
    if os.environ.get("HERDR_ENV") != "1":
        return None
    tab_id = os.environ.get("HERDR_TAB_ID")
    workspace_id = os.environ.get("HERDR_WORKSPACE_ID")
    if not tab_id or not workspace_id:
        return None
    try:
        # Do not use herdr_run()/die() here — Stop hooks must fail open and
        # never surface a non-zero exit to Codex/Claude.
        proc = subprocess.run(
            ["herdr", "tab", "get", tab_id],
            check=False,
            capture_output=True,
            text=True,
        )
        if proc.returncode != 0:
            return None
        payload = json.loads(proc.stdout)
        tab = payload.get("result", {}).get("tab")
        if not isinstance(tab, dict):
            return None
        label = tab.get("label")
        if not label or not isinstance(label, str):
            return None
        return label, tab_id, workspace_id
    except (OSError, json.JSONDecodeError):
        return None


def current_identity() -> Tuple[str, str, str]:
    """Return (label, tab_id, workspace_id) for this pane's tab."""
    require_herdr()
    tab_id = os.environ.get("HERDR_TAB_ID")
    workspace_id = os.environ.get("HERDR_WORKSPACE_ID")
    if not tab_id:
        die("HERDR_TAB_ID is not set")
    if not workspace_id:
        die("HERDR_WORKSPACE_ID is not set")

    tab = tab_info(tab_id)
    label = tab.get("label")
    if not label or not isinstance(label, str):
        die(f"tab {tab_id} has no label")
    return label, tab_id, workspace_id


def drain_own_inbox() -> List[Dict[str, Any]]:
    """Consume and return pending messages for this tab. Empty if none/unavailable."""
    identity = soft_current_identity()
    if identity is None:
        return []
    label, _tab_id, workspace_id = identity
    # sanitize_label can die() on pathological labels; keep Stop hooks fail-open.
    cleaned = re.sub(r"[^\w.\-]+", "_", label.strip(), flags=re.UNICODE).strip("._")
    if not cleaned:
        return []
    inbox = DATA_DIR / "mailboxes" / workspace_id / cleaned / "inbox"
    items = load_messages(inbox)
    messages = [data for _, data in items]
    for path, _ in items:
        try:
            path.unlink()
        except OSError as exc:
            print(f"ad: failed to remove {path.name}: {exc}", file=sys.stderr)
    return messages


def format_continue_reason(messages: List[Dict[str, Any]], *, limit: int = 9000) -> str:
    header = (
        f"[ad] You have {len(messages)} new agent-dispatch message(s). "
        "Handle them now before stopping.\n"
    )
    body = format_human(messages)
    text = header + "\n" + body
    if len(text) <= limit:
        return text
    return text[: limit - 20] + "\n…(truncated)…"


def sanitize_label(label: str) -> str:
    """Filesystem-safe form of a tab label (keeps readability)."""
    cleaned = re.sub(r"[^\w.\-]+", "_", label.strip(), flags=re.UNICODE)
    cleaned = cleaned.strip("._")
    if not cleaned:
        die(f"invalid tab label: {label!r}")
    return cleaned


def mailbox_dir(workspace_id: str, label: str) -> Path:
    return DATA_DIR / "mailboxes" / workspace_id / sanitize_label(label) / "inbox"


def resolve_recipient(label: str, sender_workspace_id: str) -> Dict[str, Any]:
    # Prefer workspace-scoped listing (herdr 0.8).
    same_ws = [t for t in list_tabs(sender_workspace_id) if t.get("label") == label]
    if len(same_ws) == 1:
        return same_ws[0]
    if len(same_ws) > 1:
        ids = ", ".join(str(t.get("tab_id")) for t in same_ws)
        die(f"ambiguous tab label {label!r} in this workspace: {ids}")

    matches = [t for t in list_tabs() if t.get("label") == label]
    if not matches:
        die(f"no tab labeled {label!r}")
    if len(matches) == 1:
        return matches[0]

    ids = ", ".join(
        f"{t.get('tab_id')} (workspace {t.get('workspace_id')})" for t in matches
    )
    die(f"ambiguous tab label {label!r} across workspaces: {ids}")


def list_agents() -> List[Dict[str, Any]]:
    payload = herdr_json(["agent", "list"])
    agents = payload.get("result", {}).get("agents")
    if not isinstance(agents, list):
        die("unexpected response from herdr agent list")
    return agents


def agents_in_tab(tab_id: str) -> List[Dict[str, Any]]:
    return [a for a in list_agents() if a.get("tab_id") == tab_id]


def nudge_prompt_text(from_label: str, body: str) -> str:
    preview = " ".join(body.strip().split())
    if len(preview) > 160:
        preview = preview[:157] + "..."
    # Keep this single-line: herdr agent prompt submits more reliably that way.
    return (
        f"[ad] New message from {from_label}. "
        f"Run `ad receive` and handle it. Preview: {preview}"
    )


def prompt_target(agent: Dict[str, Any]) -> str:
    """herdr 0.8 prefers unique live agent name; fall back to pane id."""
    name = agent.get("name")
    if isinstance(name, str) and name.strip():
        return name.strip()
    pane_id = agent.get("pane_id")
    if isinstance(pane_id, str) and pane_id:
        return pane_id
    return ""


def agent_snapshot(pane_id: str) -> Optional[Dict[str, Any]]:
    proc = herdr_run(["agent", "get", pane_id])
    if proc.returncode != 0:
        return None
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return None
    agent = payload.get("result", {}).get("agent")
    return agent if isinstance(agent, dict) else None


def prompt_accepted(before: Dict[str, Any], after: Optional[Dict[str, Any]]) -> bool:
    """True if the agent left idle after a prompt submission."""
    if not after:
        return False
    status = str(after.get("agent_status") or "")
    if status == "working":
        return True
    before_seq = before.get("state_change_seq")
    after_seq = after.get("state_change_seq")
    if (
        isinstance(before_seq, int)
        and isinstance(after_seq, int)
        and after_seq > before_seq
        and status in {"working", "blocked", "done"}
    ):
        return True
    return False


def wait_for_prompt_accepted(
    pane_id: str,
    before: Dict[str, Any],
    timeout_s: float = 5.0,
) -> Optional[Dict[str, Any]]:
    deadline = time.monotonic() + timeout_s
    latest: Optional[Dict[str, Any]] = None
    while time.monotonic() < deadline:
        latest = agent_snapshot(pane_id)
        if prompt_accepted(before, latest):
            return latest
        time.sleep(0.25)
    return latest


def notify_recipient(
    tab_id: str,
    from_label: str,
    body: str,
    *,
    force: bool,
) -> List[Dict[str, Any]]:
    """Prompt claude/codex/pi agents in the recipient tab to check their inbox.

    Returns a list of notify attempt records for logging / --json.
    """
    results: List[Dict[str, Any]] = []
    agents = agents_in_tab(tab_id)
    if not agents:
        results.append(
            {
                "ok": False,
                "reason": "no_agent_in_tab",
                "detail": f"no detected agent in tab {tab_id}",
            }
        )
        return results

    promptable = [a for a in agents if a.get("agent") in PROMPTABLE_AGENTS]
    if not promptable:
        kinds = sorted({str(a.get("agent") or "unknown") for a in agents})
        results.append(
            {
                "ok": False,
                "reason": "unsupported_agent",
                "detail": (
                    "notify supports only claude/codex/pi; "
                    f"found: {', '.join(kinds)}"
                ),
                "agents": kinds,
            }
        )
        return results

    prompt = nudge_prompt_text(from_label, body)
    for agent in promptable:
        kind = str(agent.get("agent"))
        pane_id = str(agent.get("pane_id") or "")
        target = prompt_target(agent)
        status = str(agent.get("agent_status") or "unknown")
        record: Dict[str, Any] = {
            "agent": kind,
            "pane_id": pane_id,
            "target": target,
            "status": status,
        }
        if not target:
            record.update({"ok": False, "reason": "missing_target"})
            results.append(record)
            continue
        if status in BUSY_STATUSES and not force:
            record.update(
                {
                    "ok": False,
                    "reason": "busy",
                    "detail": (
                        f"{kind} is {status}; skipped "
                        "(rerun with --force to interrupt)"
                    ),
                }
            )
            results.append(record)
            continue

        before = agent_snapshot(pane_id) or agent
        proc = herdr_run(["agent", "prompt", target, prompt])
        if proc.returncode != 0:
            err = (proc.stderr or proc.stdout or "").strip() or f"exit {proc.returncode}"
            record.update({"ok": False, "reason": "prompt_failed", "detail": err})
            results.append(record)
            continue

        if proc.stdout.strip():
            try:
                record["response"] = json.loads(proc.stdout)
            except json.JSONDecodeError:
                record["response_text"] = proc.stdout.strip()

        # herdr can ack a prompt that never starts a turn (composer stall).
        # Confirm a lifecycle change; if still idle, press Enter once (#1878).
        after = wait_for_prompt_accepted(pane_id, before, timeout_s=5.0)
        if prompt_accepted(before, after):
            record["ok"] = True
            if after:
                record["status_after"] = after.get("agent_status")
            results.append(record)
            continue

        enter = herdr_run(["agent", "send-keys", target, "Enter"])
        if enter.returncode != 0:
            err = (enter.stderr or enter.stdout or "").strip() or f"exit {enter.returncode}"
            record.update(
                {
                    "ok": False,
                    "reason": "prompt_stalled",
                    "detail": (
                        "prompt submitted but agent stayed idle; "
                        f"Enter recovery failed: {err}"
                    ),
                }
            )
            results.append(record)
            continue

        after = wait_for_prompt_accepted(pane_id, before, timeout_s=3.0)
        if prompt_accepted(before, after):
            record["ok"] = True
            record["recovered_with"] = "send-keys Enter"
            if after:
                record["status_after"] = after.get("agent_status")
        else:
            record.update(
                {
                    "ok": False,
                    "reason": "prompt_stalled",
                    "detail": (
                        "prompt submitted but agent stayed idle "
                        "(message remains in mailbox for stop-hook)"
                    ),
                    "status_after": (after or {}).get("agent_status"),
                }
            )
        results.append(record)

    return results


def ensure_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)


def write_message(inbox: Path, message: Dict[str, Any]) -> Path:
    ensure_dir(inbox)
    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    filename = f"{ts}_{message['id']}.json"
    dest = inbox / filename

    # Atomic create: write temp in same dir, then rename.
    fd, tmp_name = tempfile.mkstemp(prefix=".ad-", suffix=".tmp", dir=str(inbox))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(message, fh, indent=2, sort_keys=True)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp_name, dest)
    except Exception:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass
        raise
    return dest


def load_messages(inbox: Path) -> List[Tuple[Path, Dict[str, Any]]]:
    if not inbox.exists():
        return []
    items: List[Tuple[Path, Dict[str, Any]]] = []
    for path in sorted(inbox.glob("*.json")):
        try:
            with path.open("r", encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, json.JSONDecodeError) as exc:
            print(f"ad: skipping corrupt message {path.name}: {exc}", file=sys.stderr)
            continue
        if not isinstance(data, dict):
            print(f"ad: skipping invalid message {path.name}", file=sys.stderr)
            continue
        items.append((path, data))
    return items


def format_human(messages: List[Dict[str, Any]]) -> str:
    if not messages:
        return "(no messages)"
    blocks = []
    for i, msg in enumerate(messages, start=1):
        fr = msg.get("from", "?")
        sent = msg.get("sent_at", "?")
        body = msg.get("body", "")
        blocks.append(f"[{i}] from={fr} at={sent}\n{body}")
    return "\n\n".join(blocks)


