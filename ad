# Harnesses we can wake via `herdr agent prompt`.
PROMPTABLE_AGENTS = frozenset({"claude", "codex", "pi"})
BUSY_STATUSES = frozenset({"working"})

WAKE_DB_PATH = DATA_DIR / "wake.db"
WAKE_LAUNCHD_LABEL = "tech.leblanc.ad.wake"
WAKE_DEFAULT_MESSAGE = "continue"
WAKE_KIND_TIMER = "timer"
WAKE_KIND_SCRIPT = "script"
WAKE_KIND_PID = "pid"
WAKE_SCRIPT_LOG_DIR = DATA_DIR / "wake-scripts"
WAKE_SUBCOMMANDS = frozenset(
    {"list", "cancel", "clear", "daemon", "install", "uninstall", "status", "pid"}
)
WAKE_USAGE = (
    "wake usage:\n"
    "  ad wake <duration> [message...]\n"
    "  ad wake <script> [message...]\n"
    "  ad wake pid <pid> [message...]\n"
    "  ad wake list\n"
    "  ad wake cancel <id>\n"
    "  ad wake clear\n"
