def adopt_running_pid_wakes(
    conn: sqlite3.Connection,
    watcher: PidExitWatcher,
) -> None:
    rows = list(
        conn.execute(
            "SELECT * FROM wakes WHERE COALESCE(kind, 'timer') = ? "
            "AND status = 'running'",
            (WAKE_KIND_PID,),
