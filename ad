def _short_cmd(cmd: str, limit: int = 48) -> str:
    text = " ".join(str(cmd).split())
    if len(text) <= limit:
        return text
    return text[: limit - 1] + "…"


def cmd_wake_list(as_json: bool) -> int:
    _label, tab_id, _workspace_id = current_identity()
    with wake_db() as conn:
        rows = [
            wake_row_to_dict(r)
            for r in conn.execute(
                "SELECT * FROM wakes WHERE target_tab_id = ? "
                "AND status IN ('pending', 'firing', 'running') "
                "ORDER BY CASE COALESCE(kind, 'timer') "
                "WHEN 'script' THEN 0 WHEN 'pid' THEN 0 ELSE 1 END, "
                "due_at ASC",
                (tab_id,),
            )
        ]
    if as_json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        print("(no pending wakes)")
        return 0
    now = now_ms()
    for job in rows:
        kind = job.get("kind") or WAKE_KIND_TIMER
        if kind == WAKE_KIND_SCRIPT:
            eta = "running" if job["status"] == "running" else "script"
            detail = job.get("script_path") or ""
            msg = job["message"]
            text = f"{detail} — {msg}" if detail else msg
        elif kind == WAKE_KIND_PID:
            eta = "watching" if job["status"] == "running" else "pid"
            pid = job.get("script_pid")
            cmd = _short_cmd(job.get("script_path") or "")
            detail = f"pid {pid}"
            if cmd:
                detail = f"pid {pid} ({cmd})"
            text = f"{detail} — {job['message']}"
        else:
            remaining = job["due_at"] - now
            eta = (
                f"in {format_duration_ms(remaining)}"
                if remaining > 0
                else "due"
            )
            text = job["message"]
        print(f"{job['id'][:8]}  {eta:12}  {text}")
    return 0


def cmd_wake_cancel(prefix: str, as_json: bool) -> int:
    _label, tab_id, _workspace_id = current_identity()
    with wake_db() as conn:
        job_id = resolve_wake_id(conn, prefix, tab_id=tab_id)
        row = conn.execute("SELECT * FROM wakes WHERE id = ?", (job_id,)).fetchone()
        if row is None:
            die(f"no wake job {prefix!r}")
        if row["status"] not in {"pending", "firing", "running"}:
            die(f"wake {job_id[:8]} is {row['status']}, not cancellable")
        kind = row["kind"] if "kind" in row.keys() else WAKE_KIND_TIMER
        pid = row["script_pid"] if "script_pid" in row.keys() else None
        conn.execute(
            "UPDATE wakes SET status = 'cancelled' WHERE id = ?",
            (job_id,),
        )
        conn.commit()
    if pid and kind == WAKE_KIND_SCRIPT:
        kill_process_group(pid)
    if as_json:
        print(json.dumps({"ok": True, "id": job_id, "status": "cancelled"}, indent=2))
    else:
        print(f"cancelled {job_id[:8]}")
    return 0


def cmd_wake_clear(as_json: bool) -> int:
