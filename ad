class AdArgumentParser(argparse.ArgumentParser):
    """Fail loudly; never let argparse echo look like a successful send."""

    def error(self, message: str) -> None:  # type: ignore[override]
        if "unrecognized arguments" in message:
            unknown = message.split("unrecognized arguments:", 1)[-1].strip()
            print("ad: FAILED — invalid arguments (nothing was sent)", file=sys.stderr)
            if unknown.startswith("-"):
                opt = unknown.split()[0]
                print(f"ad: unknown option {opt!r}", file=sys.stderr)
                if opt in {"-m", "--message"} or opt.startswith("--message="):
                    print(
                        "ad: there is no --message flag. "
                        "Pass the text as a positional argument or via stdin.",
                        file=sys.stderr,
                    )
            else:
                print(f"ad: {message}", file=sys.stderr)
            print(
                "ad: send usage:\n"
                "  ad send <tab> <message text...>\n"
                "  echo '<message text>' | ad send <tab>",
                file=sys.stderr,
            )
            raise SystemExit(2)
        print(f"ad: FAILED — {message}", file=sys.stderr)
        print(f"ad: usage: {self.format_usage().strip()}", file=sys.stderr)
        raise SystemExit(2)


def build_parser() -> argparse.ArgumentParser:
    parser = AdArgumentParser(
        prog="ad",
        description="Agent dispatch — send messages between local herdr agents.",
    )
    sub = parser.add_subparsers(
        dest="command",
        required=True,
        parser_class=AdArgumentParser,
    )

    p_who = sub.add_parser("whoami", help="Show this agent's herdr tab identity")
    p_who.set_defaults(func=cmd_whoami)

    p_send = sub.add_parser("send", help="Send a message to a tab by label")
