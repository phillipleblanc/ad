def cmd_send(args: argparse.Namespace) -> int:
    from_label, from_tab_id, workspace_id = current_identity()
    body = " ".join(args.message)
    if not body and not sys.stdin.isatty():
        body = sys.stdin.read()
    if not body.strip():
        die(
            "message body is empty\n"
            "  Examples:\n"
            "    ad send <tab> hello there\n"
            "    echo 'hello there' | ad send <tab>"
        )

    recipient = resolve_recipient(args.to, workspace_id)
    to_label = recipient["label"]
    to_workspace = recipient["workspace_id"]
    to_tab_id = recipient["tab_id"]

    message = {
        "id": str(uuid.uuid4()),
        "from": from_label,
        "from_tab_id": from_tab_id,
        "from_workspace_id": workspace_id,
        "to": to_label,
        "to_tab_id": to_tab_id,
        "to_workspace_id": to_workspace,
        "body": body,
        "sent_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
    }

    path = write_message(mailbox_dir(to_workspace, to_label), message)

    # Notify by default so idle agents wake up. --no-notify opts out.
    # -n/--notify is accepted for backwards compatibility (same as default).
    notify_results: Optional[List[Dict[str, Any]]] = None
    if not args.no_notify:
        notify_results = notify_recipient(
            to_tab_id, from_label, body, force=args.force
        )

    if args.json:
        payload: Dict[str, Any] = {
            "ok": True,
            "path": str(path),
            "message": message,
        }
        if notify_results is not None:
            payload["notify"] = notify_results
        print(json.dumps(payload, indent=2))
    else:
        print(f"sent to {to_label} ({to_tab_id})")
        if notify_results is not None:
            for item in notify_results:
                if item.get("ok"):
                    print(
                        f"notified {item.get('agent')} "
                        f"({item.get('pane_id')})"
                    )
                else:
                    reason = item.get("detail") or item.get("reason") or "failed"
                    target = item.get("agent") or "recipient"
                    print(f"notify skipped/failed for {target}: {reason}", file=sys.stderr)
    return 0


def cmd_receive(args: argparse.Namespace) -> int:
    label, _tab_id, workspace_id = current_identity()
    inbox = mailbox_dir(workspace_id, label)
    items = load_messages(inbox)
    messages = [data for _, data in items]

    if args.json:
        print(json.dumps(messages, indent=2))
    else:
        print(format_human(messages))

    if not args.peek:
        for path, _ in items:
            try:
                path.unlink()
            except OSError as exc:
                print(f"ad: failed to remove {path.name}: {exc}", file=sys.stderr)

    return 0


def cmd_wait(args: argparse.Namespace) -> int:
    """Block until at least one message is available, then receive."""
    label, _tab_id, workspace_id = current_identity()
    inbox = mailbox_dir(workspace_id, label)
    deadline = None if args.timeout is None else time.monotonic() + args.timeout

    while True:
        items = load_messages(inbox)
        if items:
            # Reuse receive formatting/consume path.
            ns = argparse.Namespace(peek=args.peek, json=args.json)
            return cmd_receive(ns)
        if deadline is not None and time.monotonic() >= deadline:
            if args.json:
                print("[]")
            else:
                print("(no messages)")
            return 1
        time.sleep(args.poll)


def cmd_stop_hook(args: argparse.Namespace) -> int:
    """Claude/Codex Stop hook: continue the turn when the inbox has mail.

    Fail-open: any error or empty inbox allows the agent to stop (exit 0, no JSON).
    """
    hook_input: Dict[str, Any] = {}
    try:
        raw = sys.stdin.read()
        if raw.strip():
            parsed = json.loads(raw)
            if isinstance(parsed, dict):
                hook_input = parsed
    except json.JSONDecodeError:
        hook_input = {}

    # Claude re-invokes Stop after a block; bail out to avoid loops.
    if args.harness == "claude" and hook_input.get("stop_hook_active"):
        return 0

    try:
        messages = drain_own_inbox()
    except Exception as exc:
        print(f"ad stop-hook: {exc}", file=sys.stderr)
        return 0

    if not messages:
        return 0

    reason = format_continue_reason(messages)
    # Codex Stop schema is strict — only decision/reason (plus common fields).
    # Claude accepts the same shape.
    print(json.dumps({"decision": "block", "reason": reason}))
    return 0


def skill_md_path() -> Path:
    override = os.environ.get("AD_SKILL_PATH")
    if override:
        return Path(override)
    here = Path(__file__).resolve().parent
    candidates = [
        here / "skills" / "ad" / "SKILL.md",
        Path.home() / ".pi" / "agent" / "skills" / "ad" / "SKILL.md",
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return candidates[0]


def cmd_skill(_: argparse.Namespace) -> int:
    path = skill_md_path()
    try:
        sys.stdout.write(path.read_text(encoding="utf-8"))
    except OSError as exc:
        die(f"failed to read skill file {path}: {exc}")
    return 0


class AdArgumentParser(argparse.ArgumentParser):
    """Fail loudly; never let argparse echo look like a successful send."""

    def error(self, message: str) -> None:  # type: ignore[override]
        if "unrecognized arguments" in message:
            unknown = message.split("unrecognized arguments:", 1)[-1].strip()
            print("ad: FAILED — invalid arguments (nothing was sent)", file=sys.stderr)
            if unknown.startswith("-"):
                opt = unknown.split()[0]
                print(f"ad: unknown option {opt!r}", file=sys.stderr)
                if opt in {"-m", "--message"} or opt.startswith("--message="):
                    print(
                        "ad: there is no --message flag. "
                        "Pass the text as a positional argument or via stdin.",
                        file=sys.stderr,
                    )
            else:
                print(f"ad: {message}", file=sys.stderr)
            print(
                "ad: send usage:\n"
                "  ad send <tab> <message text...>\n"
                "  echo '<message text>' | ad send <tab>",
                file=sys.stderr,
            )
            raise SystemExit(2)
        print(f"ad: FAILED — {message}", file=sys.stderr)
        print(f"ad: usage: {self.format_usage().strip()}", file=sys.stderr)
        raise SystemExit(2)


def build_parser() -> argparse.ArgumentParser:
    parser = AdArgumentParser(
        prog="ad",
        description="Agent dispatch — send messages between local herdr agents.",
    )
    sub = parser.add_subparsers(
        dest="command",
        required=True,
        parser_class=AdArgumentParser,
    )

    p_who = sub.add_parser("whoami", help="Show this agent's herdr tab identity")
    p_who.set_defaults(func=cmd_whoami)

    p_send = sub.add_parser("send", help="Send a message to a tab by label")
    p_send.add_argument(
        "-n",
        "--notify",
        action="store_true",
        help=(
            "Wake the recipient if idle (default; kept for compatibility). "
            "Uses `herdr agent prompt` for claude/codex/pi."
        ),
    )
    p_send.add_argument(
        "--no-notify",
        action="store_true",
        help="Mailbox only; do not prompt the recipient agent",
    )
    p_send.add_argument(
        "--force",
        action="store_true",
        help="Prompt even if the recipient agent is working",
    )
    p_send.add_argument("--json", action="store_true", help="Print machine-readable output")
    p_send.add_argument("to", help="Recipient tab label (e.g. agent-message)")
    p_send.add_argument(
        "message",
        nargs="*",
        help="Message text (or pipe via stdin)",
    )
    p_send.set_defaults(func=cmd_send)

    p_recv = sub.add_parser("receive", help="Receive pending messages for this tab")
    p_recv.add_argument(
        "--peek",
        action="store_true",
        help="Show messages without consuming them",
    )
    p_recv.add_argument("--json", action="store_true", help="Print messages as JSON")
    p_recv.set_defaults(func=cmd_receive)

    p_wait = sub.add_parser("wait", help="Wait for a message, then receive it")
    p_wait.add_argument(
        "--timeout",
        type=float,
        default=None,
        help="Seconds to wait before giving up (default: forever)",
    )
    p_wait.add_argument(
        "--poll",
        type=float,
        default=0.5,
        help="Polling interval in seconds (default: 0.5)",
    )
    p_wait.add_argument(
        "--peek",
        action="store_true",
        help="Show messages without consuming them",
    )
    p_wait.add_argument("--json", action="store_true", help="Print messages as JSON")
    p_wait.set_defaults(func=cmd_wait)

    p_stop = sub.add_parser(
        "stop-hook",
        help="Stop-hook helper for claude/codex (continue turn if inbox has mail)",
    )
    p_stop.add_argument(
        "--harness",
        choices=("claude", "codex"),
        required=True,
        help="Which agent harness is invoking this hook",
    )
    p_stop.set_defaults(func=cmd_stop_hook)

    p_skill = sub.add_parser("skill", help="Print the ad SKILL.md to stdout")
    p_skill.set_defaults(func=cmd_skill)

    p_wake = sub.add_parser(
        "wake",
        help="Schedule a durable self-wake (or list/cancel/daemon)",
    )
    p_wake.add_argument(
        "--json",
        action="store_true",
        help="Print machine-readable output",
    )
    p_wake.add_argument(
        "wake_args",
        nargs="*",
        help=(
            "<duration> [message...] | list | cancel <id> | clear | "
            "daemon | install | uninstall | status"
        ),
    )
    p_wake.set_defaults(func=cmd_wake)

    return parser


def preprocess_argv(argv: Optional[Sequence[str]]) -> List[str]:
    """Normalize argv for send/wake so flags can appear after positionals."""
    if argv is None:
        raw = sys.argv[1:]
    else:
        raw = list(argv)

    if not raw:
        return list(raw)

    if raw[0] == "send":
        return _preprocess_send_argv(raw)
    if raw[0] == "wake":
        return _preprocess_wake_argv(raw)
    return list(raw)


def _preprocess_send_argv(raw: List[str]) -> List[str]:
    flags = {
        "-n",
        "--notify",
        "--no-notify",
        "--force",
        "--json",
        "-h",
        "--help",
    }
    lifted: List[str] = []
    rest: List[str] = []
    i = 1
    while i < len(raw):
        arg = raw[i]
        if arg in flags:
            lifted.append(arg)
            i += 1
            continue
        if arg == "--":
            rest.extend(raw[i + 1 :])
            break
        # Catch mistaken flags early with a clear failure (before argparse).
        if arg.startswith("-") and arg not in {"-"}:
            hint = (
                "  There is no --message/-m flag.\n"
                if arg in {"-m", "--message"} or arg.startswith("--message=")
                else ""
            )
            die(
                f"FAILED — unknown option {arg!r} (nothing was sent)\n"
                f"{hint}"
                "  Pass the message as a positional argument or via stdin.\n"
                "  Examples:\n"
                "    ad send <tab> hello there\n"
                "    echo 'hello there' | ad send <tab>"
            )
        rest.append(arg)
        i += 1

    return ["send", *lifted, *rest]


def _preprocess_wake_argv(raw: List[str]) -> List[str]:
    flags = {"--json", "-h", "--help"}
    lifted: List[str] = []
    rest: List[str] = []
    i = 1
    while i < len(raw):
        arg = raw[i]
        if arg in flags:
            lifted.append(arg)
            i += 1
            continue
        if arg == "--":
            rest.extend(raw[i + 1 :])
            break
        if arg.startswith("-") and arg not in {"-"}:
            die(
                f"FAILED — unknown option {arg!r}\n"
                "  Wake usage:\n"
                "    ad wake <duration> [message...]\n"
                "    ad wake list\n"
                "    ad wake cancel <id>"
            )
        rest.append(arg)
        i += 1
    return ["wake", *lifted, *rest]


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(preprocess_argv(argv))
    try:
        return int(args.func(args))
    except AdError as exc:
        die(str(exc))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
