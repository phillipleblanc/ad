def cmd_send(args: argparse.Namespace) -> int:
    from_label, from_tab_id, workspace_id = current_identity()
    body = " ".join(args.message)
    if not body and not sys.stdin.isatty():
        body = sys.stdin.read()
    if not body.strip():
        die(
            "message body is empty\n"
            "  Examples:\n"
            "    ad send <tab> hello there\n"
            "    echo 'hello there' | ad send <tab>"
        )

    recipient = resolve_recipient(args.to, workspace_id)
    to_label = recipient["label"]
    to_workspace = recipient["workspace_id"]
    to_tab_id = recipient["tab_id"]

    message = {
        "id": str(uuid.uuid4()),
        "from": from_label,
        "from_tab_id": from_tab_id,
        "from_workspace_id": workspace_id,
        "to": to_label,
        "to_tab_id": to_tab_id,
        "to_workspace_id": to_workspace,
        "body": body,
        "sent_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
    }

    path = write_message(mailbox_dir(to_workspace, to_label), message)

    # Notify by default so idle agents wake up. --no-notify opts out.
    # -n/--notify is accepted for backwards compatibility (same as default).
    notify_results: Optional[List[Dict[str, Any]]] = None
    if not args.no_notify:
        notify_results = notify_recipient(
            to_tab_id, from_label, body, force=args.force
        )

    if args.json:
        payload: Dict[str, Any] = {
            "ok": True,
            "path": str(path),
            "message": message,
        }
        if notify_results is not None:
            payload["notify"] = notify_results
        print(json.dumps(payload, indent=2))
    else:
        print(f"sent to {to_label} ({to_tab_id})")
        if notify_results is not None:
            for item in notify_results:
                if item.get("ok"):
                    print(
                        f"notified {item.get('agent')} "
                        f"({item.get('pane_id')})"
                    )
                else:
                    reason = item.get("detail") or item.get("reason") or "failed"
                    target = item.get("agent") or "recipient"
                    print(f"notify skipped/failed for {target}: {reason}", file=sys.stderr)
    return 0


