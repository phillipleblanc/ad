def cmd_wait(args: argparse.Namespace) -> int:
    """Block until at least one message is available, then receive."""
    label, _tab_id, workspace_id = current_identity()
    inbox = mailbox_dir(workspace_id, label)
    deadline = None if args.timeout is None else time.monotonic() + args.timeout

    while True:
        items = load_messages(inbox)
        if items:
            # Reuse receive formatting/consume path.
            ns = argparse.Namespace(peek=args.peek, json=args.json)
            return cmd_receive(ns)
        if deadline is not None and time.monotonic() >= deadline:
            if args.json:
                print("[]")
            else:
                print("(no messages)")
            return 1
        time.sleep(args.poll)


def _stop_hook_log(message: str) -> None:
    """Best-effort diagnostic log for harness Stop-hook failures."""
    try:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        path = DATA_DIR / "stop-hook.log"
        ts = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
        with path.open("a", encoding="utf-8") as fh:
            fh.write(f"{ts} {message}\n")
    except OSError:
        pass


def cmd_stop_hook(args: argparse.Namespace) -> int:
    """Claude/Codex Stop hook: continue the turn when the inbox has mail.

    Fail-open: never exit non-zero. Codex surfaces any non-0/2 status as
    "Stop hook (failed) / hook exited with code N", which interrupts the UX
    even when mail delivery is optional. Empty inbox => exit 0, no stdout.
    """
    try:
        return _cmd_stop_hook_inner(args)
    except BrokenPipeError:
        _stop_hook_log("broken pipe")
        return 0
    except SystemExit as exc:
        code = 0 if exc.code is None else exc.code
        if isinstance(code, int) and code != 0:
            _stop_hook_log(f"swallowed SystemExit {code}")
            print(f"ad stop-hook: swallowed exit {code}", file=sys.stderr)
        return 0
    except Exception as exc:
        _stop_hook_log(f"error: {exc}")
        print(f"ad stop-hook: {exc}", file=sys.stderr)
        return 0


def _cmd_stop_hook_inner(args: argparse.Namespace) -> int:
    hook_input: Dict[str, Any] = {}
    try:
        raw = sys.stdin.read()
        if raw.strip():
            parsed = json.loads(raw)
            if isinstance(parsed, dict):
                hook_input = parsed
    except json.JSONDecodeError:
        hook_input = {}

    # Both harnesses re-invoke Stop after a block; bail out to avoid loops.
    if hook_input.get("stop_hook_active"):
        return 0

    messages = drain_own_inbox()
    if not messages:
        return 0

    reason = format_continue_reason(messages)
    if not reason.strip():
        reason = (
            f"[ad] You have {len(messages)} new agent-dispatch message(s). "
            "Handle them now before stopping."
        )
    # Codex Stop schema is strict — only decision/reason (plus common fields).
    # Claude accepts the same shape. Exit 0 with JSON (not exit 2).
    payload = json.dumps({"decision": "block", "reason": reason}, ensure_ascii=False)
    try:
        sys.stdout.write(payload + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        _stop_hook_log("broken pipe while writing block decision")
    _stop_hook_log(
        f"blocked harness={args.harness} messages={len(messages)} "
        f"reason_chars={len(reason)}"
    )
    return 0


def skill_md_path() -> Path:
    override = os.environ.get("AD_SKILL_PATH")
    if override:
        return Path(override)
    here = Path(__file__).resolve().parent
    candidates = [
        here / "skills" / "ad" / "SKILL.md",
        Path.home() / ".pi" / "agent" / "skills" / "ad" / "SKILL.md",
