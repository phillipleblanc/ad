def cmd_wake_daemon(_: argparse.Namespace) -> int:
    """Persistent wake worker; intended to run under launchd."""
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    print(f"ad wake daemon starting (db={WAKE_DB_PATH})", flush=True)
    # Keep one long-lived connection; reopen only after errors.
    conn: Optional[sqlite3.Connection] = None
    children: Dict[str, subprocess.Popen] = {}
    pid_watcher = PidExitWatcher()
    while True:
        try:
            if conn is None:
                DATA_DIR.mkdir(parents=True, exist_ok=True)
                conn = sqlite3.connect(str(WAKE_DB_PATH), timeout=30)
                conn.row_factory = sqlite3.Row
                conn.execute("PRAGMA journal_mode=WAL")
                ensure_wake_schema(conn)
            start_pending_script_wakes(conn, children)
            reap_script_wakes(conn, children)
            start_pending_pid_wakes(conn, pid_watcher)
            adopt_running_pid_wakes(conn, pid_watcher)
            reap_pid_wakes(conn, pid_watcher)
            for job in claim_due_wakes(conn):
                fire_wake_job(conn, job)
            sleep_s = next_wake_sleep_s(conn)
        except Exception as exc:
            print(f"ad wake daemon error: {exc}", file=sys.stderr, flush=True)
            if conn is not None:
                try:
                    conn.close()
                except Exception:
                    pass
                conn = None
            time.sleep(1.0)
            continue

        time.sleep(sleep_s)


def cmd_wake(args: argparse.Namespace) -> int:
    tokens = list(args.wake_args)
    as_json = bool(args.json)
    if not tokens:
        die(WAKE_USAGE)

    head = tokens[0]
    if head == "list":
        return cmd_wake_list(as_json)
    if head == "cancel":
        if len(tokens) < 2:
            die("usage: ad wake cancel <id>")
        return cmd_wake_cancel(tokens[1], as_json)
    if head == "clear":
        return cmd_wake_clear(as_json)
    if head == "daemon":
        return cmd_wake_daemon(args)
    if head == "install":
        install_wake_launchd()
        print(f"installed launchd agent {WAKE_LAUNCHD_LABEL}")
        print(f"running={wake_daemon_is_running()}")
        return 0
    if head == "uninstall":
        uninstall_wake_launchd()
        print(f"uninstalled launchd agent {WAKE_LAUNCHD_LABEL}")
        return 0
    if head == "status":
        running = wake_daemon_is_running()
        if as_json:
            print(
                json.dumps(
                    {
                        "label": WAKE_LAUNCHD_LABEL,
                        "plist": str(wake_plist_path()),
                        "running": running,
                        "db": str(WAKE_DB_PATH),
                    },
                    indent=2,
                )
            )
        else:
            print(f"label={WAKE_LAUNCHD_LABEL}")
            print(f"plist={wake_plist_path()}")
            print(f"running={running}")
            print(f"db={WAKE_DB_PATH}")
        return 0 if running else 1
    if head == "pid":
        if len(tokens) < 2:
            die("usage: ad wake pid <pid> [message...]")
        return cmd_wake_pid(tokens[1], tokens[2:], as_json=as_json)

    if try_parse_duration_ms(head) is not None:
        return cmd_wake_schedule(head, tokens[1:], as_json=as_json)
    if looks_like_script_arg(head):
        return cmd_wake_script(head, tokens[1:], as_json=as_json)
    die(
        f"invalid wake target {head!r}\n"
        "  Use a duration (30s, 2m, 1h30m), a script path, or pid <pid>.\n"
        "  Examples:\n"
        "    ad wake 5m check the build\n"
        "    ad wake ./wait-for-ci.sh continue\n"
        "    ad wake pid 12345 continue"
    )
    return 1


