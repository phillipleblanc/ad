    p_wait.add_argument("--json", action="store_true", help="Print messages as JSON")
    p_wait.set_defaults(func=cmd_wait)

    p_stop = sub.add_parser(
        "stop-hook",
        help="Stop-hook helper for claude/codex (continue turn if inbox has mail)",
    )
    p_stop.add_argument(
        "--harness",
        choices=("claude", "codex"),
        required=True,
        help="Which agent harness is invoking this hook",
    )
    p_stop.set_defaults(func=cmd_stop_hook)

    p_skill = sub.add_parser("skill", help="Print the ad SKILL.md to stdout")
    p_skill.set_defaults(func=cmd_skill)

    p_wake = sub.add_parser(
        "wake",
        help="Schedule a durable self-wake (or list/cancel/daemon)",
    )
    p_wake.add_argument(
        "--json",
        action="store_true",
        help="Print machine-readable output",
    )
    p_wake.add_argument(
        "wake_args",
        nargs="*",
        help=(
            "<duration> [message...] | <script> [message...] | pid <pid> [message...] | "
            "list | cancel <id> | clear | daemon | install | uninstall | status"
        ),
    )
    p_wake.set_defaults(func=cmd_wake)

    return parser


def preprocess_argv(argv: Optional[Sequence[str]]) -> List[str]:
    """Normalize argv for send/wake so flags can appear after positionals."""
    if argv is None:
        raw = sys.argv[1:]
    else:
        raw = list(argv)

    if not raw:
        return list(raw)

    if raw[0] == "send":
        return _preprocess_send_argv(raw)
    if raw[0] == "wake":
        return _preprocess_wake_argv(raw)
    return list(raw)


def _preprocess_send_argv(raw: List[str]) -> List[str]:
    flags = {
        "-n",
        "--notify",
        "--no-notify",
        "--force",
        "--json",
        "-h",
        "--help",
    }
    lifted: List[str] = []
    rest: List[str] = []
    i = 1
    while i < len(raw):
        arg = raw[i]
        if arg in flags:
            lifted.append(arg)
            i += 1
            continue
        if arg == "--":
            rest.extend(raw[i + 1 :])
            break
        # Catch mistaken flags early with a clear failure (before argparse).
        if arg.startswith("-") and arg not in {"-"}:
            hint = (
                "  There is no --message/-m flag.\n"
                if arg in {"-m", "--message"} or arg.startswith("--message=")
                else ""
            )
            die(
                f"FAILED — unknown option {arg!r} (nothing was sent)\n"
                f"{hint}"
                "  Pass the message as a positional argument or via stdin.\n"
                "  Examples:\n"
                "    ad send <tab> hello there\n"
                "    echo 'hello there' | ad send <tab>"
            )
        rest.append(arg)
        i += 1

    return ["send", *lifted, *rest]


def _preprocess_wake_argv(raw: List[str]) -> List[str]:
    flags = {"--json", "-h", "--help"}
    lifted: List[str] = []
    rest: List[str] = []
    i = 1
    while i < len(raw):
        arg = raw[i]
        if arg in flags:
            lifted.append(arg)
            i += 1
            continue
        if arg == "--":
            rest.extend(raw[i + 1 :])
            break
        if arg.startswith("-") and arg not in {"-"}:
            die(
                f"FAILED — unknown option {arg!r}\n"
                "  Wake usage:\n"
                "    ad wake <duration> [message...]\n"
                "    ad wake <script> [message...]\n"
                "    ad wake pid <pid> [message...]\n"
                "    ad wake list\n"
                "    ad wake cancel <id>"
            )
        rest.append(arg)
        i += 1
    return ["wake", *lifted, *rest]


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(preprocess_argv(argv))
    try:
        return int(args.func(args))
    except AdError as exc:
        die(str(exc))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
