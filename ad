def try_parse_duration_ms(raw: str) -> Optional[int]:
    compact = raw.strip().lower().replace(" ", "")
    if not compact:
        return None
    unit_ms = {"ms": 1, "s": 1000, "m": 60_000, "h": 3_600_000, "d": 86_400_000}
    pattern = re.compile(r"(\d+(?:\.\d+)?)(ms|s|m|h|d)")
    total = 0.0
    index = 0
    matched = False
    for match in pattern.finditer(compact):
        if match.start() != index:
            return None
        matched = True
        amount = float(match.group(1))
        if amount < 0:
            return None
        total += amount * unit_ms[match.group(2)]
        index = match.end()
    if not matched or index != len(compact) or total <= 0:
        return None
    return int(total + 0.999999)  # ceil without importing math


def parse_duration_ms(raw: str) -> int:
    parsed = try_parse_duration_ms(raw)
    if parsed is None:
        die(f"invalid duration {raw!r} (examples: 30s, 2m, 1h30m)")
    return parsed


def looks_like_script_arg(raw: str) -> bool:
    if not raw or raw in WAKE_SUBCOMMANDS:
        return False
    expanded = Path(raw).expanduser()
    if expanded.is_file():
        return True
    if raw.startswith(("./", "../", "/", "~")) or "/" in raw:
        return True
    return Path(raw).suffix.lower() in {".sh", ".bash", ".zsh", ".fish", ".py", ".rb"}


def resolve_wake_script(raw: str) -> Path:
    path = Path(raw).expanduser()
    if not path.is_absolute():
        path = Path.cwd() / path
    try:
        path = path.resolve()
    except OSError as exc:
        die(f"wake script {raw!r} could not be resolved: {exc}")
    if not path.is_file():
        die(f"wake script not found: {raw}")
    return path


def format_duration_ms(ms: int) -> str:
    remaining = max(0, int(ms))
    if remaining < 1000:
        return f"{remaining}ms"
    parts: List[str] = []
    days, remaining = divmod(remaining, 86_400_000)
    hours, remaining = divmod(remaining, 3_600_000)
    minutes, remaining = divmod(remaining, 60_000)
    seconds = (remaining + 999) // 1000
    if days:
        parts.append(f"{days}d")
    if hours:
        parts.append(f"{hours}h")
    if minutes:
        parts.append(f"{minutes}m")
    if seconds:
        parts.append(f"{seconds}s")
    return " ".join(parts) or "0s"


def now_ms() -> int:
    return int(time.time() * 1000)


def ensure_wake_schema(conn: sqlite3.Connection) -> None:
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS wakes (
            id TEXT PRIMARY KEY,
            target_tab_id TEXT NOT NULL,
            target_workspace_id TEXT NOT NULL,
            target_label TEXT NOT NULL,
            message TEXT NOT NULL,
            due_at INTEGER NOT NULL,
            status TEXT NOT NULL,
            created_at INTEGER NOT NULL,
            fired_at INTEGER,
            error TEXT,
            kind TEXT NOT NULL DEFAULT 'timer',
            script_path TEXT,
            script_pid INTEGER,
            script_cwd TEXT,
            script_exit INTEGER
        )
        """
    )
    columns = {row[1] for row in conn.execute("PRAGMA table_info(wakes)")}
    migrations = (
        ("kind", "TEXT NOT NULL DEFAULT 'timer'"),
        ("script_path", "TEXT"),
        ("script_pid", "INTEGER"),
        ("script_cwd", "TEXT"),
        ("script_exit", "INTEGER"),
    )
    for name, decl in migrations:
        if name not in columns:
            conn.execute(f"ALTER TABLE wakes ADD COLUMN {name} {decl}")
    conn.execute(
        "CREATE INDEX IF NOT EXISTS idx_wakes_pending_due "
        "ON wakes(status, due_at)"
    )
    conn.commit()


@contextmanager
def wake_db() -> Iterator[sqlite3.Connection]:
    """Open the wake DB and always close it.

    sqlite3.Connection's own context manager only commits/rollbacks — it does
    not close. The wake daemon used to open a connection every loop via
    `with wake_db()`, leaking FDs until SQLite failed with
    "unable to open database file" and due jobs never fired.
    """
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(WAKE_DB_PATH), timeout=30)
    conn.row_factory = sqlite3.Row
    try:
        conn.execute("PRAGMA journal_mode=WAL")
        ensure_wake_schema(conn)
        yield conn
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


def wake_row_to_dict(row: sqlite3.Row) -> Dict[str, Any]:
    return {key: row[key] for key in row.keys()}


def resolve_wake_id(
    conn: sqlite3.Connection, prefix: str, *, tab_id: Optional[str] = None
) -> str:
    if tab_id is None:
        rows = list(
            conn.execute(
                "SELECT id FROM wakes WHERE id = ? OR id LIKE ?",
                (prefix, f"{prefix}%"),
            )
        )
    else:
        rows = list(
            conn.execute(
                "SELECT id FROM wakes WHERE target_tab_id = ? "
                "AND (id = ? OR id LIKE ?)",
                (tab_id, prefix, f"{prefix}%"),
            )
        )
    if not rows:
        die(f"no wake job matching {prefix!r}")
    if len(rows) > 1 and not any(r["id"] == prefix for r in rows):
        ids = ", ".join(r["id"][:8] for r in rows[:8])
        die(f"ambiguous wake id prefix {prefix!r}: {ids}")
    for row in rows:
        if row["id"] == prefix:
            return row["id"]
    return rows[0]["id"]


def deliver_to_tab(
    *,
    tab_id: str,
    workspace_id: str,
    label: str,
    body: str,
    from_label: str = "wake",
) -> Dict[str, Any]:
    """Write a mailbox message and attempt herdr notify (idle agents only)."""
    message = {
        "id": str(uuid.uuid4()),
        "from": from_label,
        "from_tab_id": tab_id,
        "from_workspace_id": workspace_id,
        "to": label,
        "to_tab_id": tab_id,
        "to_workspace_id": workspace_id,
        "body": body,
        "sent_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
    }
    path = write_message(mailbox_dir(workspace_id, label), message)
    try:
        notify_results = notify_recipient(tab_id, from_label, body, force=False)
    except SystemExit as exc:
        # herdr helpers call die(); keep the daemon alive and keep the mailbox write.
        notify_results = [
            {
                "ok": False,
                "reason": "herdr_error",
                "detail": f"notify aborted (exit {exc.code})",
            }
        ]
    return {"path": str(path), "message": message, "notify": notify_results}


def script_log_path(job_id: str) -> Path:
    return WAKE_SCRIPT_LOG_DIR / f"{job_id}.log"


def pid_is_alive(pid: Optional[int]) -> bool:
    if pid is None or int(pid) <= 0:
        return False
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def process_is_running(pid: Optional[int]) -> bool:
    """True if pid exists and is not a zombie."""
    if not pid_is_alive(pid):
        return False
    state = process_ps_field(int(pid), "state")
    if state and state[:1].upper() == "Z":
        return False
    return True


def parse_watch_pid(raw: str) -> int:
    text = raw.strip()
    if not text.isdigit() or int(text) <= 0:
        die(f"invalid pid {raw!r}")
    pid = int(text)
    if not process_is_running(pid):
        die(f"no such process {pid}")
    return pid


def process_ps_field(pid: int, field: str) -> Optional[str]:
    try:
        proc = subprocess.run(
            ["ps", "-p", str(pid), "-o", f"{field}="],
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError:
        return None
    if proc.returncode != 0:
        return None
    value = (proc.stdout or "").strip()
    return value or None


def process_start_key(pid: int) -> Optional[str]:
    return process_ps_field(pid, "lstart")


def process_command_line(pid: int) -> str:
    return process_ps_field(pid, "command") or f"pid {pid}"


def decode_wait_status(status: int) -> Optional[int]:
    try:
        if os.WIFEXITED(status):
            return int(os.WEXITSTATUS(status))
        if os.WIFSIGNALED(status):
            return 128 + int(os.WTERMSIG(status))
    except (OverflowError, OSError, ValueError):
        return None
    return None


# Python's select module often omits these Darwin NOTE_* bits; the values
# are stable in sys/event.h. Without NOTE_EXITSTATUS, kevent data is 0
# even when the process was killed.
KQ_NOTE_EXITSTATUS = int(getattr(select, "KQ_NOTE_EXITSTATUS", 0x04000000))
KQ_NOTE_EXIT_DETAIL = int(getattr(select, "KQ_NOTE_EXIT_DETAIL", 0x02000000))


class PidExitWatcher:
    """Watch foreign PIDs until they exit.

    On macOS, kqueue EVFILT_PROC/NOTE_EXITSTATUS can supply wait(2) status.
    Elsewhere (or if kqueue fails) we poll liveness and detect PID reuse.
    """

    def __init__(self) -> None:
        self._kq: Any = None
        if hasattr(select, "kqueue"):
            try:
                self._kq = select.kqueue()
            except OSError:
                self._kq = None
        self._job_ids_by_pid: Dict[int, List[str]] = {}
        self._start_key: Dict[str, Optional[str]] = {}
        self._pid_by_job: Dict[str, int] = {}
        self._kq_armed: Dict[str, bool] = {}

    def is_watching(self, job_id: str) -> bool:
        return job_id in self._pid_by_job

    def watch(self, job_id: str, pid: int, start_key: Optional[str]) -> bool:
        """Register a watch. Returns False if the process is already gone."""
        pid = int(pid)
        self.unwatch(job_id)
        self._job_ids_by_pid.setdefault(pid, []).append(job_id)
        self._start_key[job_id] = start_key
        self._pid_by_job[job_id] = pid
        self._kq_armed.pop(job_id, None)
        if self._kq is None:
            return True
        flags = select.KQ_NOTE_EXIT | KQ_NOTE_EXITSTATUS | KQ_NOTE_EXIT_DETAIL
        try:
            self._kq.control(
                [
                    select.kevent(
                        pid,
                        select.KQ_FILTER_PROC,
                        select.KQ_EV_ADD | select.KQ_EV_ONESHOT,
                        flags,
                    )
                ],
                0,
            )
        except ProcessLookupError:
            self.unwatch(job_id)
            return False
        except (OSError, OverflowError, ValueError):
            return True
        self._kq_armed[job_id] = True
        return True

    def unwatch(self, job_id: str) -> None:
        pid = self._pid_by_job.pop(job_id, None)
        self._start_key.pop(job_id, None)
        self._kq_armed.pop(job_id, None)
        if pid is None:
            return
        remaining = [jid for jid in self._job_ids_by_pid.get(pid, []) if jid != job_id]
        if remaining:
            self._job_ids_by_pid[pid] = remaining
        else:
            self._job_ids_by_pid.pop(pid, None)

    def poll_exits(self) -> List[Tuple[str, Optional[int]]]:
        finished: List[Tuple[str, Optional[int]]] = []
        finished_ids = set()
        if self._kq is not None:
            try:
                events = self._kq.control(None, 64, 0)
            except OSError:
                events = []
            for event in events:
                pid = int(event.ident)
                exit_code: Optional[int] = None
                if int(event.fflags) & KQ_NOTE_EXITSTATUS:
                    exit_code = decode_wait_status(int(event.data))
                for job_id in list(self._job_ids_by_pid.get(pid, [])):
                    finished.append((job_id, exit_code))
                    finished_ids.add(job_id)
                    self.unwatch(job_id)
        for pid, job_ids in list(self._job_ids_by_pid.items()):
            alive = process_is_running(pid)
            current_key = process_start_key(pid) if alive else None
            for job_id in list(job_ids):
                if job_id in finished_ids:
                    continue
                if self._kq_armed.get(job_id):
                    # kqueue NOTE_EXIT is authoritative; don't race it with kill(0).
                    continue
                expected = self._start_key.get(job_id)
                reused = bool(
                    alive and expected and current_key and current_key != expected
                )
                if (not alive) or reused:
                    finished.append((job_id, None))
                    finished_ids.add(job_id)
                    self.unwatch(job_id)
        return finished


def kill_process_group(pid: Optional[int]) -> None:
    if pid is None or int(pid) <= 0:
        return
    pid = int(pid)
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(pid, sig)
        except (ProcessLookupError, PermissionError, OSError):
            try:
                os.kill(pid, sig)
            except (ProcessLookupError, PermissionError, OSError):
                return
        if sig == signal.SIGTERM:
            time.sleep(0.15)
            if not pid_is_alive(pid):
                return


def read_log_tail(path: Path, max_bytes: int = 8000) -> str:
    try:
        data = path.read_bytes()
    except OSError:
        return ""
    if len(data) > max_bytes:
        data = data[-max_bytes:]
        text = data.decode("utf-8", errors="replace")
        nl = text.find("\n")
        if nl >= 0:
            text = text[nl + 1 :]
        return "…\n" + text
    return data.decode("utf-8", errors="replace")


def format_script_completion_message(
    job: Dict[str, Any], exit_code: Optional[int]
) -> str:
    body = str(job.get("message") or "").rstrip()
    path = job.get("script_path") or "script"
    if exit_code is None:
        status_line = f"[ad wake] {path} finished (exit code unknown)"
    else:
        status_line = f"[ad wake] {path} exited {exit_code}"
    parts = [body, "", status_line] if body else [status_line]
    output = read_log_tail(script_log_path(job["id"]))
    if output.strip():
        parts.extend(["output:", output.rstrip()])
    return "\n".join(parts)


def format_pid_completion_message(
    job: Dict[str, Any], exit_code: Optional[int]
) -> str:
    body = str(job.get("message") or "").rstrip()
    pid = job.get("script_pid")
    cmd = str(job.get("script_path") or "").strip() or f"pid {pid}"
    if exit_code is None:
        status_line = f"[ad wake] pid {pid} ({cmd}) finished (exit code unknown)"
    else:
        status_line = f"[ad wake] pid {pid} ({cmd}) exited {exit_code}"
    parts = [body, "", status_line] if body else [status_line]
    return "\n".join(parts)


def spawn_wake_script(job: Dict[str, Any]) -> subprocess.Popen:
    script = Path(str(job["script_path"]))
    cwd = job.get("script_cwd") or str(script.parent)
    WAKE_SCRIPT_LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = script_log_path(job["id"])
    if os.access(script, os.X_OK):
        argv = [str(script)]
    else:
        argv = ["/bin/bash", str(script)]
    log_fh = log_path.open("w", encoding="utf-8")
    try:
        return subprocess.Popen(
            argv,
            cwd=str(cwd),
            stdout=log_fh,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
    finally:
        log_fh.close()


def start_pending_script_wakes(
    conn: sqlite3.Connection,
    children: Dict[str, subprocess.Popen],
) -> None:
    rows = list(
        conn.execute(
            "SELECT * FROM wakes WHERE COALESCE(kind, 'timer') = ? "
            "AND status = 'pending'",
            (WAKE_KIND_SCRIPT,),
        )
    )
    for row in rows:
        cur = conn.execute(
            "UPDATE wakes SET status = 'running' "
            "WHERE id = ? AND status = 'pending'",
            (row["id"],),
        )
        conn.commit()
        if cur.rowcount != 1:
            continue
        job = wake_row_to_dict(row)
        try:
            proc = spawn_wake_script(job)
        except Exception as exc:
            conn.execute(
                "UPDATE wakes SET status = ?, fired_at = ?, error = ? WHERE id = ?",
                ("fired", now_ms(), f"failed to start script: {exc}", job["id"]),
            )
            conn.commit()
            print(
                f"ad wake: script start failed {job['id'][:8]}: {exc}",
                file=sys.stderr,
                flush=True,
            )
            continue
        conn.execute(
            "UPDATE wakes SET script_pid = ? WHERE id = ?",
            (proc.pid, job["id"]),
        )
        conn.commit()
        children[job["id"]] = proc
        print(
            f"ad wake: started script {job['id'][:8]} pid={proc.pid} "
            f"{job.get('script_path')}",
            flush=True,
        )


def reap_script_wakes(
    conn: sqlite3.Connection,
    children: Dict[str, subprocess.Popen],
) -> None:
    rows = list(
        conn.execute(
            "SELECT * FROM wakes WHERE COALESCE(kind, 'timer') = ? "
            "AND status IN ('running', 'cancelled')",
            (WAKE_KIND_SCRIPT,),
        )
    )
    for row in rows:
        job = wake_row_to_dict(row)
        job_id = job["id"]
        proc = children.get(job_id)
        if job["status"] == "cancelled":
            if proc is not None:
                kill_process_group(proc.pid)
                children.pop(job_id, None)
            elif job.get("script_pid"):
                kill_process_group(job.get("script_pid"))
            continue

        exit_code: Optional[int] = None
        done = False
        if proc is not None:
            code = proc.poll()
            if code is not None:
                done = True
                exit_code = int(code)
        else:
            pid = job.get("script_pid")
            if pid_is_alive(pid):
                continue
            done = True
        if not done:
            continue
        children.pop(job_id, None)
        cur = conn.execute(
            "UPDATE wakes SET status = 'firing', script_exit = ? "
            "WHERE id = ? AND status = 'running'",
            (exit_code, job_id),
        )
        conn.commit()
        if cur.rowcount != 1:
            continue
        job["message"] = format_script_completion_message(job, exit_code)
        fire_wake_job(conn, job)


def pid_start_key_reused(pid: Optional[int], expected: Optional[str]) -> bool:
    if pid is None or int(pid) <= 0:
        return False
    if not expected:
        return False
    current = process_start_key(int(pid))
    return bool(current and current != expected)


def arm_or_fire_pid_job(
    conn: sqlite3.Connection,
    watcher: PidExitWatcher,
    job: Dict[str, Any],
) -> None:
    pid = job.get("script_pid")
    expected = job.get("script_cwd")
    gone = (not process_is_running(pid)) or pid_start_key_reused(pid, expected)
    if gone or not watcher.watch(job["id"], int(pid), expected):
        cur = conn.execute(
            "UPDATE wakes SET status = 'firing', script_exit = NULL "
            "WHERE id = ? AND status = 'running'",
            (job["id"],),
        )
        conn.commit()
        if cur.rowcount != 1:
            return
        job["message"] = format_pid_completion_message(job, None)
        fire_wake_job(conn, job)
        return
    print(
        f"ad wake: watching pid {job['id'][:8]} pid={pid} {job.get('script_path')}",
        flush=True,
    )


def start_pending_pid_wakes(
    conn: sqlite3.Connection,
    watcher: PidExitWatcher,
